      "version": "1.34.0",
      "toolsId": "94137d8b-3005-4692-8f79-a1c6bb78404a"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
